generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
}

enum CandidateStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String     @id @default(cuid())
  role             Role       @default(ADMIN)
  name             String?
  email            String     @unique
  password         String?
  mobile           String?    @unique
  location         String?
  status           UserStatus @default(ACTIVE)
  lastLogin        DateTime?

  // OTP Fields (from DB)
  otp              String?
  otpExpiry        DateTime?


  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  candidates       Candidate[]
  placements       Placement[]

  resetRequests    PasswordResetRequest[] @relation("UserResetRequests")

  // Commercial & Payment Terms (Recruiter)
  commissionPercentage    Float?    @default(0)
  paymentTermsDays        Int?
  paymentReleaseCondition String?
  recruiterType           String?
  agreementSigned         Boolean   @default(false)
  agreementDate           DateTime?
  agreementExpiryDate     DateTime?
}

enum JobTiming {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobPriority {
  HIGH
  MEDIUM
  LOW
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  industry           String?
  logoUrl            String?
  website            String?
  contactPerson      String?
  email              String?
  phone              String?
  status             CompanyStatus @default(ACTIVE)
  notes              String?
  isConfidential     Boolean       @default(false)

  // Physical & Logical info
  totalEmployees     String?
  workingDays        String?
  workingHours       String?
  location           String?
  clientSince        DateTime?

  // Interview Process Details
  round1Name         String?
  round1Desc         String?

  round2Name         String?
  round2Desc         String?

  round3Name         String?
  round3Desc         String?

  finalRoundName     String?
  finalRoundDesc     String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  jobs               Job[]
  placements         Placement[]

  // Commercial Terms (Admin Only)
  recruitmentFeePercentage Float?
  paymentTermsDays         Int?
  replacementPeriodDays    Int?
  gstApplicable            Boolean?      @default(true)
  clientAgreementSigned    Boolean?      @default(false)
  agreementExpiryDate      DateTime?
  commercialRemarks        String?
}

enum JobGender {
  MALE
  FEMALE
  BOTH
}

model Job {
  id           String        @id @default(cuid())
  title        String
  department   String
  location     String
  status       JobStatus     @default(OPEN)
  description  String?

  postedDate   DateTime      @default(now())
  experience   String?
  skills       String?
  salaryRange  String?
  industry     String?
  jobTiming    JobTiming     @default(FULL_TIME)
  workingDays  String?
  workingHours String?
  priority     JobPriority   @default(MEDIUM)
  gender       JobGender     @default(BOTH)
  vacancies    Int           @default(1)
  education    String?

  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  placements   Placement[]
}

model Candidate {
  id              String        @id @default(cuid())
  firstName       String
  status          CandidateStatus @default(ACTIVE)
  lastName        String?
  email           String        @unique
  phone           String?

  currentLocation String?
  experience      String?
  currentSalary   String?
  expectedSalary  String?
  noticePeriod    String?
  skills          String?
  remarks         String?
  resumeUrl       String?
  resumeFileName  String?
  portfolioUrl    String?

  recruiterId     String?
  recruiter       User?         @relation(fields: [recruiterId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  placements      Placement[]
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW_SCHEDULED
  L1_CLEARED
  L2_CLEARED
  SELECTED
  REJECTED
  JOINED
  BACKED_OUT
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  status      ApplicationStatus @default(SUBMITTED)
  offeredCTC  Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job       @relation(fields: [jobId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
  placement Placement?
}

enum PlacementStatus {
  SELECTED
  JOINED
  INVOICE_GENERATED
  INVOICE_PAID
  RECRUITER_PAID
}

model Placement {
  id               String          @id @default(cuid())

  applicationId    String          @unique
  candidateId      String
  companyId        String
  jobId            String
  recruiterId      String?

  application      Application     @relation(fields: [applicationId], references: [id])
  candidate        Candidate       @relation(fields: [candidateId], references: [id])
  company          Company         @relation(fields: [companyId], references: [id])
  job              Job             @relation(fields: [jobId], references: [id])
  recruiter        User?           @relation(fields: [recruiterId], references: [id])

  offeredCTC       Float
  placementValue   Float
  recruiterCommissionPercentage Float
  recruiterShare   Float
  talentonusShare  Float

  joiningDate      DateTime?
  expectedJoiningDate DateTime?
  invoiceNumber    String?
  invoiceDate      DateTime?
  invoiceAmount    Float?
  paymentReceivedDate DateTime?
  recruiterPaidDate DateTime?
  recruiterPaymentStatus String @default("PENDING")
  remarks          String?

  status           PlacementStatus @default(SELECTED)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}


enum PasswordResetStatus {
  PENDING
  COMPLETED
}

model PasswordResetRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], name: "UserResetRequests")

  status      PasswordResetStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt


}
