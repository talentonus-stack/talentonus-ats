generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id         String     @id @default(cuid())
  role       Role       @default(ADMIN)
  name       String?
  email      String     @unique
  password   String?
  mobile     String?    @unique
  location   String?
  status     UserStatus @default(ACTIVE)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  candidates Candidate[]
}

enum JobTiming {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobPriority {
  HIGH
  MEDIUM
  LOW
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum JobGender {
  MALE
  FEMALE
  BOTH
}

model Job {
  id           String        @id @default(cuid())
  title        String
  department   String
  location     String
  status       JobStatus     @default(OPEN)
  description  String?

  postedDate   DateTime      @default(now())
  experience   String?
  skills       String?
  salaryRange  String?
  industry     String?
  jobTiming    JobTiming     @default(FULL_TIME)
  workingDays  String?
  priority     JobPriority   @default(MEDIUM)
  gender       JobGender     @default(BOTH)
  vacancies    Int           @default(1)
  education    String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Candidate {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String?
  email           String        @unique
  phone           String?

  currentLocation String?
  experience      String?
  currentSalary   String?
  expectedSalary  String?
  noticePeriod    String?
  skills          String?
  remarks         String?
  resumeUrl       String?
  resumeFile      String?
  portfolioUrl    String?

  recruiterId     String?
  recruiter       User?         @relation(fields: [recruiterId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW_SCHEDULED
  L1_CLEARED
  L2_CLEARED
  SELECTED
  REJECTED
  JOINED
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job       @relation(fields: [jobId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
}
